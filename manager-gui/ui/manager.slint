import { Button, ScrollView } from "std-widgets.slint";
import { StatusPage } from "./status.slint";
import { ConfigPage } from "./config.slint";
import { LogsPage } from "./logs.slint";

struct ConnectEntry {
    url: string,
    value: string,
}

// ─── 分割线 ───
component DivideLine inherits Path {
    width: 100%;
    height: 1px;
    stroke: #d5d5dd;
    stroke-width: 1px;

    MoveTo {
        x: 0;
        y: 0;
    }

    LineTo {
        x: 100%;
        y: 0;
    }
}


// ─── 导航 Tab 按钮 ───
component NavTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in-out property <brush> active-color: #6c63ff;
    callback clicked();

    min-width: 80px;
    height: 44px;
    background: active ? #6c63ff10 : #00000000;
    border-radius: 10px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;

        Text {
            text: label;
            font-size: 13px;
            font-weight: active ? 600 : 400;
            color: active ? #1a1a2e : #5a5a70;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if active: Rectangle {
        x: 0;
        y: parent.height - 2px;
        width: 100%;
        height: 2px;
        background: active-color;
        border-radius: 1px;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}


// ─── 主窗口 ───
export component ManagerWindow inherits Window {
    width: 960px;
    height: 720px;
    title: "Campus Auto-Login";
    default-font-family: "Microsoft YaHei";
    icon: @image-url("../icons/neco.png");
    background: #f0f0f5;

    // ═══ 运行状态 ═══
    in-out property <int> running-status: 0;  // 0=待检测 1=运行中 2=未运行
    in-out property <string> uptime: "--";

    // ═══ 环境检测 ═══
    in-out property <bool> config-toml-ok: false;
    in-out property <string> config-toml-path: "";
    in-out property <bool> elements-toml-ok: false;
    in-out property <string> elements-toml-path: "";
    in-out property <bool> chrome-ok: false;
    in-out property <string> chrome-path: "";
    in-out property <bool> chromedriver-ok: false;
    in-out property <string> chromedriver-path: "";

    // ── 环境操作进行中标记 ──
    in-out property <bool> env-config-processing: false;
    in-out property <bool> env-elements-processing: false;
    in-out property <bool> env-chrome-processing: false;
    in-out property <bool> env-driver-processing: false;

    // ═══ 配置管理 ═══
    in-out property <string> config-toml-text: "";
    in-out property <string> config-login-username: "";
    in-out property <string> config-login-password: "";
    in-out property <string> config-login-service: "_service_0";
    in-out property <[string]> config-service-names;
    in-out property <int> config-service-current-index: 0;
    in-out property <string> config-login-eportal: "http://eportal.hhu.edu.cn";
    in-out property <string> config-login-timout: "3";
    in-out property <string> config-query-interval: "15";
    in-out property <[ConnectEntry]> config-connect-entries;
    in-out property <string> config-driver-port: "18888";
    in-out property <string> config-driver-path: "chromedriver-win64/chromedriver.exe";
    in-out property <string> config-browser-path: "chrome-win64/chrome.exe";
    in-out property <string> config-save-error: "";

    // ═══ 日志 ═══
    in-out property <string> log-content: "";
    in-out property <int> log-line-count: 0;
    in-out property <int> log-total-count: 0;

    // ═══ 页面索引 ═══
    property <int> current-index: 0;

    // ── 纯函数 ──
    pure function button-text() -> string {
        if (running-status == 1) {
            return "停止";
        }
        return "开始";
    }

    pure function status-text() -> string {
        if (running-status == 0) {
            return "待检测";
        }
        if (running-status == 1) {
            return "运行中";
        }
        if (running-status == 2) {
            return "未运行";
        }
        return "";
    }

    pure function status-color() -> brush {
        if (running-status == 1) {
            return #34d399;
        }
        if (running-status == 2) {
            return #ff6584;
        }
        return #6b7280;
    }

    pure function status-action-text() -> string {
        if (running-status == 0) {
            return "—";
        }
        if (running-status == 1) {
            return "停止";
        }
        if (running-status == 2) {
            return "启动";
        }
        return "";
    }

    pure function status-action-enabled() -> bool {
        return running-status != 0;
    }

    // ── 回调 ──
    callback check-running-status(int);
    callback update-running-status(int);
    callback check-environment();
    callback save-config();          // 由 config-action 变化触发
    callback load-config();          // 由 config-action 变化触发
    callback refresh-logs();
    callback clear-logs();

    // ── 环境操作回调 ──
    callback env-create-config();
    callback env-create-elements();
    callback env-download-chrome();
    callback env-download-driver();

    // ── config-action: ConfigPage 设 "load"/"save"，changed 回调触发 ──
    in-out property <string> config-action: "";
    changed config-action => {
        if (root.config-action == "save") {
            root.save-config();
        }
        if (root.config-action == "load") {
            root.load-config();
        }
        root.config-action = "";
    }

    // ── connect-action: ConfigPage 设 "add" / "del-N" → Rust 处理 ──
    callback connect-edit(string);
    in-out property <string> connect-action: "";
    changed connect-action => {
        if (root.connect-action != "") {
            root.connect-edit(root.connect-action);
            root.connect-action = "";
        }
    }

    // ── 定时器：刷新状态 + 环境检测 ──
    timer := Timer {
        interval: 500ms;
        running: true;
        triggered() => {
            check-running-status(running-status);
            check-environment();
        }
    }

    // ═══════ 根布局 ═══════

    VerticalLayout {
        // ── 顶部导航栏 ──
        Rectangle {
            height: 56px;
            background: #f5f5fa;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;

                // 品牌区域
                Rectangle {
                    width: 160px;
                    height: 40px;
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 28px;
                            height: 40px;
                            border-radius: 6px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../icons/neco.png");
                                    width: parent.width;
                                    height: parent.width;
                                    image-fit: contain;
                                }
                            }
                        }

                        Text {
                            text: "Campus Login";
                            font-size: 14px;
                            font-weight: 700;
                            color: #1a1a2e;
                            vertical-alignment: center;
                        }
                    }
                }

                NavTab {
                    label: "运行状态";
                    active: root.current-index == 0;
                    active-color: #34d399;
                    clicked => {
                        root.current-index = 0;
                    }
                }

                NavTab {
                    label: "配置管理";
                    active: root.current-index == 1;
                    active-color: #6c63ff;
                    clicked => {
                        root.current-index = 1;
                    }
                }

                NavTab {
                    label: "日志查看";
                    active: root.current-index == 2;
                    active-color: #60a5fa;
                    clicked => {
                        root.current-index = 2;
                    }
                }
            }
        }

        DivideLine { }

        // ── 内容区域 (Tab 切换) ──
        Rectangle {
            width: 100%;
            vertical-stretch: 1;

            if (root.current-index == 0): StatusPage {
                running-status-text: status-text();
                status-dot-color: status-color();
                uptime: root.uptime;

                status-action-text: status-action-text();
                status-action-enabled: status-action-enabled();
                status-action-clicked => {
                    root.update-running-status(running-status);
                }

                env-action-config => { root.env-create-config(); }
                env-action-elements => { root.env-create-elements(); }
                env-action-chrome => { root.env-download-chrome(); }
                env-action-driver => { root.env-download-driver(); }

                env-config-processing: root.env-config-processing;
                env-elements-processing: root.env-elements-processing;
                env-chrome-processing: root.env-chrome-processing;
                env-driver-processing: root.env-driver-processing;

                config-toml-ok: root.config-toml-ok;
                config-toml-path: root.config-toml-path;
                elements-toml-ok: root.elements-toml-ok;
                elements-toml-path: root.elements-toml-path;
                chrome-ok: root.chrome-ok;
                chrome-path: root.chrome-path;
                chromedriver-ok: root.chromedriver-ok;
                chromedriver-path: root.chromedriver-path;
            }

            if (root.current-index == 1): ConfigPage {
                config-toml-text <=> root.config-toml-text;

                login-username <=> root.config-login-username;
                login-password <=> root.config-login-password;
                login-service <=> root.config-login-service;
                service-names <=> root.config-service-names;
                service-current-index <=> root.config-service-current-index;
                login-eportal <=> root.config-login-eportal;
                login-timout <=> root.config-login-timout;
                query-interval <=> root.config-query-interval;
                connect-entries <=> root.config-connect-entries;
                driver-port <=> root.config-driver-port;
                driver-path <=> root.config-driver-path;
                browser-path <=> root.config-browser-path;

                config-action <=> root.config-action;
                connect-action <=> root.connect-action;
                config-exists <=> root.config-toml-ok;
                save-error <=> root.config-save-error;
            }

            if (root.current-index == 2): LogsPage {
                log-content: root.log-content;
                log-line-count: root.log-line-count;
                log-total-count: root.log-total-count;
                refresh-logs() => {
                    root.refresh-logs();
                }
                clear-logs() => {
                    root.clear-logs();
                }
            }
        }

        DivideLine { }

        // ── 底部状态栏 ──
        Rectangle {
            height: 52px;
            background: #f5f5fa;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;

                // 状态指示
                Rectangle {
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: status-color();
                            }
                        }
                        Rectangle {
                            width: 10px;
                        }
                        Text {
                            text: status-text();
                            font-size: 13px;
                            font-weight: 600;
                            color: #1a1a2e;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 100%;
                }

                Button {
                    text: button-text();
                    primary: true;
                    width: 100px;
                    height: 32px;
                    enabled: running-status != 0;
                    clicked => {
                        update-running-status(running-status);
                    }
                }
            }
        }
    }
}

import { Switch } from "std-widgets.slint";
import { StatusSvgIcon } from "./svgicon.slint";

// 运行状态页面 — 服务状态 + 运行时环境检测
export component StatusPage inherits Rectangle {
    background: #f0f0f5;

    // ── 由 Rust 端刷新的属性 ──
    in-out property <string> running-status-text: "检测中...";
    in-out property <brush> status-dot-color: #6b7280;
    in-out property <string> uptime: "--";

    // ── 状态操作按钮 ──
    in-out property <string> status-action-text: "启动";
    in-out property <bool> status-action-enabled: false;
    callback status-action-clicked();

    // ── 环境检测 ──
    in-out property <bool> config-toml-ok: false;
    in-out property <string> config-toml-path: "";
    in-out property <bool> elements-toml-ok: false;
    in-out property <string> elements-toml-path: "";
    in-out property <bool> chrome-ok: false;
    in-out property <string> chrome-path: "";
    in-out property <bool> chromedriver-ok: false;
    in-out property <string> chromedriver-path: "";

    // ── 环境操作回调 ──
    callback env-action-config();
    callback env-action-elements();
    callback env-action-chrome();
    callback env-action-driver();

    // ── 操作进行中标记（按钮禁用+文字切换） ──
    in-out property <bool> env-config-processing: false;
    in-out property <bool> env-elements-processing: false;
    in-out property <bool> env-chrome-processing: false;
    in-out property <bool> env-driver-processing: false;

    // ── 辅助 — 对勾/叉号 + 颜色 ──
    // pure function check-icon(ok: bool) -> string {
    //     if ok {
    //         return "✓";
    //     }
    //     return "✗";
    // }
    pure function check-color(ok: bool) -> brush {
        if ok {
            return #34d399;
        }
        return #ff6584;
    }

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        // ═══ 第一行：服务状态 + 运行时长 ═══
        HorizontalLayout {
            spacing: 16px;

            // 服务状态卡片
            Rectangle {
                horizontal-stretch: 1;
                background: #ffffff;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.status-dot-color == #34d399 ? #34d39930 : #e0e0e6;
                height: 100px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                        Text {
                            text: "服务状态";
                            font-size: 13px;
                            color: #5a5a70;
                            font-weight: 500;
                        }

                    HorizontalLayout {

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: root.status-dot-color;
                            }
                        }

                        Rectangle {
                            width: 10px;
                        }

                        Text {
                            text: root.running-status-text;
                            font-size: 28px;
                            font-weight: 700;
                            color: #1a1a2e;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        status-btn := Rectangle {
                            width: 72px;
                            height: 32px;
                            border-radius: 8px;
                            background: root.status-action-enabled ? #6c63ff : #e0e0e8;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.status-action-text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: root.status-action-enabled ? #ffffff : #a0a0b0;
                                    horizontal-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => {
                                    root.status-action-clicked();
                                }
                                enabled: root.status-action-enabled;
                            }
                        }
                    }
                }
            }

            // 运行时长卡片
            Rectangle {
                horizontal-stretch: 1;
                background: #ffffff;
                border-radius: 12px;
                border-width: 1px;
                border-color: #e0e0e6;
                height: 100px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                        Text {
                            text: "运行时长";
                            font-size: 13px;
                            color: #5a5a70;
                        font-weight: 500;
                    }

                    Text {
                            text: root.uptime;
                            font-size: 28px;
                            font-weight: 700;
                            color: #1a1a2e;
                    }
                }
            }
        }

        // ═══ 开机自启设置 ═══
        Rectangle {
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e0e0e6;
            height: 56px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "开机自启";
                            font-size: 13px;
                            color: #5a5a70;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "（功能尚未实现）";
                            font-size: 10px;
                            color: #a0a0b0;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Switch {
                    checked: false;
                    enabled: false;
                }
            }
        }

        // ═══ 第二行：运行环境检测 ═══
        Rectangle {
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e0e0e6;
            vertical-stretch: 0;
            VerticalLayout {
                padding: 20px;
                spacing: 4px;

                Text {
                    text: "运行环境检测";
                    font-size: 15px;
                    font-weight: 600;
                    color: #1a1a2e;
                }

                // 分割
                Rectangle {
                    height: 12px;
                }

                // ── config.toml ──
                env-row := Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        Text {
                            text: "📄 config.toml";
                            font-size: 13px;
                            color: #5a5a70;
                            width: 160px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 80px;
                            height: 36px;
                            background: transparent;
                            StatusSvgIcon {
                                ok: root.config-toml-ok;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            text: root.config-toml-path;
                            font-size: 11px;
                            color: #8a8aa0;
                            font-family: "Cascadia Code";
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if (!root.config-toml-ok): Rectangle {
                            width: root.env-config-processing ? 80px : 64px;
                            height: 28px;
                            border-radius: 6px;
                            background: #6c63ff10;
                            border-width: 1px;
                            border-color: #6c63ff18;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.env-config-processing ? "处理中..." : "创建";
                                    font-size: 12px;
                                    color: root.env-config-processing ? #a0a0b0 : #6c63ff;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.env-action-config(); }
                                enabled: !root.env-config-processing;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #eaeaef;
                }

                // ── elements.toml ──
                Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        Text {
                            text: "📄 elements.toml";
                            font-size: 13px;
                            color: #5a5a70;
                            width: 160px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 80px;
                            height: 36px;
                            background: transparent;
                            StatusSvgIcon {
                                ok: root.elements-toml-ok;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            text: root.elements-toml-path;
                            font-size: 11px;
                            color: #8a8aa0;
                            font-family: "Cascadia Code";
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if (!root.elements-toml-ok): Rectangle {
                            width: root.env-elements-processing ? 80px : 64px;
                            height: 28px;
                            border-radius: 6px;
                            background: #6c63ff10;
                            border-width: 1px;
                            border-color: #6c63ff18;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.env-elements-processing ? "处理中..." : "创建";
                                    font-size: 12px;
                                    color: root.env-elements-processing ? #a0a0b0 : #6c63ff;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.env-action-elements(); }
                                enabled: !root.env-elements-processing;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #eaeaef;
                }

                // ── Chrome ──
                Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        Text {
                            text: "🌐 Chrome 浏览器";
                            font-size: 13px;
                            color: #5a5a70;
                            width: 160px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 80px;
                            height: 36px;
                            background: transparent;
                            StatusSvgIcon {
                                ok: root.chrome-ok;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            text: root.chrome-path;
                            font-size: 11px;
                            color: #8a8aa0;
                            font-family: "Cascadia Code";
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if (!root.chrome-ok): Rectangle {
                            width: root.env-chrome-processing ? 80px : 64px;
                            height: 28px;
                            border-radius: 6px;
                            background: #6c63ff10;
                            border-width: 1px;
                            border-color: #6c63ff18;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.env-chrome-processing ? "下载中..." : "下载";
                                    font-size: 12px;
                                    color: root.env-chrome-processing ? #a0a0b0 : #6c63ff;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.env-action-chrome(); }
                                enabled: !root.env-chrome-processing;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #eaeaef;
                }

                // ── ChromeDriver ──
                Rectangle {
                    height: 36px;
                    HorizontalLayout {
                        Text {
                            text: "🔧 ChromeDriver";
                            font-size: 13px;
                            color: #5a5a70;
                            width: 160px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 80px;
                            height: 36px;
                            background: transparent;
                            StatusSvgIcon {
                                ok: root.chromedriver-ok;
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            text: root.chromedriver-path;
                            font-size: 11px;
                            color: #8a8aa0;
                            font-family: "Cascadia Code";
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if (!root.chromedriver-ok): Rectangle {
                            width: root.env-driver-processing ? 80px : 64px;
                            height: 28px;
                            border-radius: 6px;
                            background: #6c63ff10;
                            border-width: 1px;
                            border-color: #6c63ff18;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.env-driver-processing ? "下载中..." : "下载";
                                    font-size: 12px;
                                    color: root.env-driver-processing ? #a0a0b0 : #6c63ff;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.env-action-driver(); }
                                enabled: !root.env-driver-processing;
                            }
                        }
                    }
                }
            }
        }

        // 弹性占位 — 吸收剩余垂直空间，防止上方卡片被拉伸
        Rectangle {
            vertical-stretch: 1;
        }
    }
}

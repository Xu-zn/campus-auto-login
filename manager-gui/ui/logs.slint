// 日志查看页面 — Slint 兼容版
import { Button, ScrollView, TextEdit } from "std-widgets.slint";

export component LogsPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #f0f0f5;

    in-out property <string> log-content: "";
    in-out property <int>    log-line-count: 0;
    in-out property <int>    log-total-count: 0;
    in-out property <string> log-filter-level: "all";

    callback refresh-logs();
    callback clear-logs();
    callback export-logs();

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // 工具栏
        Rectangle {
            height: 36px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "日志查看"; font-size: 18px; font-weight: 600; color: #1a1a2e; }

                Rectangle {
                    background: #e8e8f2;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        Rectangle { background: root.log-filter-level == "all" ? #6c63ff18 : #00000000; border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                padding-top: 5px; padding-bottom: 5px;
                                Text { text: "全部"; font-size: 11px; font-weight: 500; color: root.log-filter-level == "all" ? #6c63ff : #5a5a70; }
                            }
                            TouchArea { clicked => { root.log-filter-level = "all"; } }
                        }
                        Rectangle { background: root.log-filter-level == "info" ? #60a5fa30 : #00000000; border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                padding-top: 5px; padding-bottom: 5px;
                                Text { text: "INFO"; font-size: 11px; font-weight: 500; color: root.log-filter-level == "info" ? #60a5fa : #5a5a70; }
                            }
                            TouchArea { clicked => { root.log-filter-level = "info"; } }
                        }
                        Rectangle { background: root.log-filter-level == "warn" ? #f4a26130 : #00000000; border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                padding-top: 5px; padding-bottom: 5px;
                                Text { text: "WARN"; font-size: 11px; font-weight: 500; color: root.log-filter-level == "warn" ? #f4a261 : #5a5a70; }
                            }
                            TouchArea { clicked => { root.log-filter-level = "warn"; } }
                        }
                        Rectangle { background: root.log-filter-level == "error" ? #ff658420 : #00000000; border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                padding-top: 5px; padding-bottom: 5px;
                                Text { text: "ERROR"; font-size: 11px; font-weight: 500; color: root.log-filter-level == "error" ? #ff6584 : #5a5a70; }
                            }
                            TouchArea { clicked => { root.log-filter-level = "error"; } }
                        }
                    }
                }

                Button { text: "↻ 刷新"; clicked => { root.refresh-logs(); } }
                Button { text: "清除"; clicked => { root.clear-logs(); } }
            }
        }

        // 日志内容区
        Rectangle {
            background: #ffffff;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e0e0e6;
            VerticalLayout {
                Rectangle {
                    height: 32px;
                    background: #e8e8f2;
                    HorizontalLayout {
                        padding: 8px;
                        Text {
                            text: "显示 " + root.log-line-count + " 条 · 共 " + root.log-total-count + " 条";
                            font-size: 11px; color: #8a8aa0;
                            font-family: "Cascadia Code";
                        }
                    }
                }

                ScrollView {
                    TextEdit {
                        text <=> root.log-content;
                        font-size: 11px;
                        font-family: "Cascadia Code";
                        wrap: word-wrap;
                        read-only: true;
                        min-height: 360px;
                    }
                }

                Rectangle {
                    height: 36px;
                    background: #e8e8f2;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Text { text: "自动刷新间隔: 3s"; font-size: 11px; color: #8a8aa0; vertical-alignment: center; }
                        Button { text: "⬇ 导出日志"; clicked => { root.export-logs(); } }
                    }
                }
            }
        }
    }
}
